        "jsCode": "const item = $input.item;\nconst base64 = item.json.body?.data?.message?.audioMessage?.base64 || item.json.body?.data?.base64 || item.json.body?.data?.message?.base64 || '';\nconst cleanBase64 = base64.replace(/^data:.*?;base64,/, '');\n\nif (!cleanBase64) {\n  throw new Error('Áudio em Base64 não encontrado. Verifique se \"base64: true\" está ativo nas configurações do Webhook da Evolution.');\n}\n\nitem.binary = {\n  file: {\n    data: cleanBase64,\n    mimeType: 'audio/ogg',\n    fileName: 'audio.ogg'\n  }\n};\n\nreturn item;"
