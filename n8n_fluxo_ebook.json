{
  "name": "Fluxo de Envio de E-book (Tzion)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "agenda-sincronismo",
        "options": {}
      },
      "id": "webhook-node",
      "name": "Webhook Supabase",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        250,
        300
      ],
      "webhookId": "agenda-sincronismo"
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.body.type }}",
              "value2": "ebook_purchase"
            }
          ]
        }
      },
      "id": "if-node",
      "name": "Foi compra de E-book?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        450,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.sua-evolution.com/message/sendText/NOME_DA_INSTANCIA",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "SUA_API_KEY_AQUI"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"number\": \"{{ $json.body.customer_phone.replace(/\\D/g, '') }}\",\n  \"text\": \"Olá, *{{ $json.body.customer_name.split(' ')[0] }}*! 🎉\\n\\nO seu pagamento via PIX foi confirmado com sucesso!\\n\\nAqui está o link para você baixar e acessar o seu material exclusivo (*{{ $json.body.product_name }}*):\\n\\n👉 [COLE_O_LINK_DO_SEU_PDF_OU_DRIVE_AQUI]\\n\\nMuito obrigado e aproveite a leitura!\"\n}",
        "options": {}
      },
      "id": "http-node",
      "name": "Enviar WhatsApp (Evolution API)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        650,
        280
      ]
    }
  ],
  "connections": {
    "Webhook Supabase": {
      "main": [
        [
          {
            "node": "Foi compra de E-book?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Foi compra de E-book?": {
      "main": [
        [
          {
            "node": "Enviar WhatsApp (Evolution API)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
